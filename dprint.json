{
  "lineWidth": 100,
  "json": {
    "useTabs": false
  },
  "markdown": {
    "textWrap": "always"
  },
  "toml": { "sortKeys": true },
  "includes": ["**/*.md", "**/*.toml", "**/*.json", "**/*.yaml"],

  "excludes": ["target/**", "**/CHANGELOG.md"],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.28.0.wasm",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
